# /dns
async def dns(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.args:
        await update.message.reply_text("❌ Use: /dns <domínio>")
        return

    dominio = context.args[0]

    if not dominio_valido(dominio):
        await update.message.reply_text(
            "❌ Domínio inválido."
        )
        return

    await update.message.reply_text(
        f"Consultando DNS de {dominio}..."
    )

    try:
        informacoes = socket.getaddrinfo(
            dominio,
            None
        )

        ips = set()

        for info in informacoes:
            ips.add(info[4][0])

        if not ips:
            await update.message.reply_text(
                "Nenhum endereço IP encontrado."
            )
            return

        resultado = "\n".join(sorted(ips))

        await update.message.reply_text(
            f"Resultado DNS\n\n"
            f"Domínio: {dominio}\n\n"
            f"Endereços IP:\n"
            f"{resultado}"
        )

    except socket.gaierror:
        await update.message.reply_text(
            "❌ Não foi possível resolver esse domínio."
        )

    except Exception as erro:
        print("ERRO DNS:", erro)

        await update.message.reply_text(
            "❌ Erro ao realizar a consulta DNS."
        )

