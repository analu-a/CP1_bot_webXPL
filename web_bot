# /nmap
async def nmap(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.args:
        await update.message.reply_text("❌ Use: /nmap <host>")
        return

    host = context.args[0]

    await update.message.reply_text(
        f"Executando scan em {host}..."
    )

    try:
        processo = await asyncio.create_subprocess_exec(
            "nmap", "-sV", "--top-ports", "20", host,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )

        saida, erro = await processo.communicate()

        if processo.returncode != 0:
            await update.message.reply_text(
                "❌ Host inválido ou inacessível."
            )
            return

        resultado = saida.decode()
        portas = []

        for linha in resultado.splitlines():
            if "/tcp" in linha and ("open" in linha or "filtered" in linha):
                portas.append(linha)

        if portas:
            formatado = "\n".join(portas)

            await update.message.reply_text(
                f"Resultado do Nmap\n\n"
                f"Host: {host}\n\n"
                f"Portas e serviços:\n"
                f"{formatado}"
            )

        else:
            await update.message.reply_text(
                f"Nenhuma porta aberta encontrada em {host}."
            )

    except Exception:
        await update.message.reply_text(
            "❌ Erro ao executar o Nmap."
        )


# /gau
async def gau(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.args:
        await update.message.reply_text("❌ Use: /gau <domínio>")
        return

    dominio = context.args[0]

    if not dominio_valido(dominio):
        await update.message.reply_text("❌ Domínio inválido.")
        return

    await update.message.reply_text(
        f"Buscando URLs de {dominio}..."
    )

    try:
        processo = await asyncio.create_subprocess_exec(
            "gau", dominio,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )

        try:
            saida, erro = await asyncio.wait_for(
                processo.communicate(),
                timeout=30
            )

        except asyncio.TimeoutError:
            processo.kill()
            saida, erro = await processo.communicate()

        resultado = saida.decode().splitlines()

        if not resultado:
            await update.message.reply_text(
                "Nenhuma URL encontrada ou as fontes externas "
                "do GAU estão indisponíveis."
            )
            return

        # Mostra no máximo 30 URLs
        urls = resultado[:30]

        mensagem = (
            f"Resultado do GAU\n\n"
            f"Domínio: {dominio}\n"
            f"URLs encontradas: {len(resultado)}\n\n"
            + "\n".join(urls)
        )

        if len(resultado) > 30:
            mensagem += (
                "\n\nExibindo apenas as primeiras 30 URLs."
            )

        await update.message.reply_text(
            mensagem[:4000]
        )

    except FileNotFoundError:
        await update.message.reply_text(
            "❌ GAU não está instalado ou não foi encontrado no PATH."
        )

    except Exception as erro:
        print("ERRO GAU:", erro)

        await update.message.reply_text(
            "❌ Erro ao executar o GAU."
        )


# /crt
async def crt(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.args:
        await update.message.reply_text("❌ Use: /crt <domínio>")
        return

    dominio = context.args[0]

    if not dominio_valido(dominio):
        await update.message.reply_text("❌ Domínio inválido.")
        return

    await update.message.reply_text(
        f"Buscando subdomínios de {dominio}..."
    )

    try:
        resposta = requests.get(
            f"https://crt.sh/?q=%25.{dominio}&output=json",
            timeout=60
        )

        # Verifica se a consulta ao crt.sh respondeu corretamente
        if resposta.status_code != 200:
            await update.message.reply_text(
                f"❌ A consulta ao crt.sh apresentou um erro "
                f"(HTTP {resposta.status_code})."
            )
            return

        dados = resposta.json()
        subdominios = set()

        for item in dados:
            for nome in item["name_value"].splitlines():
                nome = nome.replace("*.", "").strip()

                # Mantém apenas subdomínios e remove e-mails
                if nome.endswith("." + dominio) and "@" not in nome:
                    subdominios.add(nome)

        if not subdominios:
            await update.message.reply_text(
                "Nenhum subdomínio encontrado."
            )
            return

        resultado = "\n".join(sorted(subdominios))

        await update.message.reply_text(
            f"Subdomínios - {dominio}\n\n"
            f"{resultado[:3800]}"
        )

    except requests.exceptions.Timeout:
        await update.message.reply_text(
            "❌ A consulta ao crt.sh demorou muito para responder."
        )

    except requests.exceptions.RequestException:
        await update.message.reply_text(
            "❌ Não foi possível realizar a consulta ao crt.sh."
        )

    except ValueError:
        await update.message.reply_text(
            "❌ O crt.sh retornou uma resposta inválida."
        )

    except Exception as erro:
        print("ERRO CRT:", erro)

        await update.message.reply_text(
            "❌ Erro ao consultar o crt.sh."
        )


